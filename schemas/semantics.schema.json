{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_scene/semantics/0.1",
  "title": "AI Scene Package near-route spatial semantics (semantics.json)",
  "description": "What exists around the route, in route-relative coordinates. Structure here; rules (route coverage, playable band, overlaps) are checked by tools/semantics.py. See docs/SEMANTICS.md.",
  "type": "object",
  "required": ["version", "route_id", "extent_m", "zones"],
  "properties": {
    "version": {"const": "0.1"},
    "route_id": {"type": "string", "minLength": 1},
    "extent_m": {"type": "number", "exclusiveMinimum": 0},
    "source": {"type": "object"},
    "zones": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/zone"}}
  },
  "$defs": {
    "range": {"type": "array", "minItems": 2, "items": {"type": "number"}},
    "zone": {
      "type": "object",
      "required": ["id", "semantic_type", "side", "from_s", "to_s", "lateral_offset_m", "confidence", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "semantic_type": {"enum": ["road", "trail", "sidewalk", "grass", "forest", "water", "cliff", "slope", "wall",
                                   "guardrail", "fence", "building_zone", "vegetation_zone", "bridge", "tunnel",
                                   "open_space"]},
        "side": {"enum": ["left", "right", "both"]},
        "from_s": {"type": "number", "minimum": 0},
        "to_s": {"type": "number", "exclusiveMinimum": 0},
        "lateral_offset_m": {"$ref": "#/$defs/range"},
        "vertical_offset_m": {"type": ["array", "null"], "items": {"type": "number"}},
        "confidence": {"type": "number", "minimum": 0},
        "attributes": {"type": "object"},
        "source": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["video", "ai", "map", "dem", "gps", "scene_generator", "procedural", "manual"]},
            "ref": {"type": "string"},
            "estimated": {"type": "boolean"},
            "note": {"type": "string"}
          }
        }
      }
    }
  }
}
