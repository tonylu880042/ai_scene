  "shared_fit_contract": {
    "base_sample_source": "Native SaisiesGeoRoute records in native_base_samples, interpolated only in station. Do not rebuild world coordinates from the offline geographic points for this candidate.",
    "canonical_output": "One corrected station-indexed sample array is the source for runtime pos_at/tangent_at/left_at/ground_y, Curve3D, asphalt vertices, road collision, markings, shoulders, terrain projection and geography route samples.",
    "centerline_fit": "Fit a local planar heading spline in route station, integrate it at the existing station samples, then anchor the XZ result to the old sample at both outer blend boundaries. Use a C1 smoothstep or cubic Hermite blend with zero correction and zero correction derivative at each outer boundary.",
    "heading_convention": "Native heading is atan2(tangent.x, -tangent.z) in degrees. With this Godot frame, a decreasing heading is a route-left turn and an increasing heading is route-right. The stored heading_delta_deg is target_heading_minus_native_heading using the shortest signed angle.",
    "grade_fit": "Use each segment's source grade contract as an authored target inside its edit window: S06 -6.5..-7.5%, S10 +7.5..+8.5%, S12 -3.0..-4.0%. Integrate the target grade in station and retain the road_height_delta hints as a reviewable vertical envelope. The fit must assert the source sign, especially the continuous uphill S10 passage; it must never silently turn it into a downhill segment.",
    "height_fit": "road_height_delta_knots_m are relative to the native route height at the same station. They are hints generated from the requested grade, not a replacement for native terrain sampling. Close any integrated height residual only through the two explicit 200..250m outer blend windows, returning correction and derivative to zero at the edit/outer boundaries. Never compress a residual into a 44/50m return that creates an artificial steep grade.",
    "boundary_contract": {
      "blend_width_m": 250.0,
      "blend_width_range_m": [
        200.0,
        250.0
      ],
      "outer_position_xz": "exact native sample at outer_start_m and outer_end_m",
      "outer_heading": "exact native heading and zero correction at outer boundaries",
      "outer_grade": "exact native grade at outer boundaries unless a native-ground audit rejects the transition",
      "continuity": "C1 in centerline position/tangent and road height at both outer boundaries; no hard station seam",
      "height_closure": "The fit tool reports raw residual, closure peak correction and maximum closed grade in both blend windows. The compiled sample is provisional until native coverage includes every expanded outer station."
    },
    "required_rebuild_together": [
      "runtime route samples and heading/elevation/grade arrays",
      "Curve3D and route API tangent/left/ground queries",
      "asphalt visible mesh, road collision, center markings and gravel shoulders",
      "SaisiesGeography.set_route_samples() data and route spatial hash",
      "visible baked terrain/road ribbon and SaisiesS01Landscape triangle sampler/index when that baked surface is used",
      "station/lateral authored roadside, forest and terminal instances, reprojected through the corrected route frame",
      "native release geometry cache, rebuilt and re-hashed after the source scene is ready"
    ],
    "fixed_world_policy": "Houses, rocks and other fixed world anchors are not translated as a group. Audit each against the corrected route side contract; move only when its authored station/lateral contract explicitly binds it to the route.",
    "reject_if": [
      "station samples are not strictly increasing or the route endpoint changes",
      "heading/grade correction leaks outside the outer blend window",
      "visible asphalt or collision differs from runtime route API samples",
      "geography route samples or baked terrain index still references the old centerline",
      "road_height_delta blend produces unbounded grade, terrain penetration or a camera-only visual fix"
    ]
  },
