class_name SaisiesLandscape
extends Node3D

## Static, world-space landscape for the Col des Saisies route.
##
## The existing SaisiesMountains backdrop follows the rider and is useful as a
## horizon layer, but it cannot support a baked scene because it has no stable
## world position.  This node builds one deterministic heightfield over the
## whole route.  The road-side ribbon generated by SaisiesRoute remains the
## visible near surface; this mesh is deliberately kept below that ribbon in a
## protected corridor so it cannot form a wall across the road.

@export var route_path: NodePath
@export var world_extent_m := 3000.0
@export var grid_spacing_m := 100.0
@export var route_sample_spacing_m := 120.0
@export var corridor_radius_m := 110.0
@export var protection_radius_m := 155.0
@export var corridor_sink_m := 22.0
@export var transition_end_m := 720.0
@export var random_seed := 806
@export var max_vertices := 100000

var route: SaisiesRoute
var landscape_ready := false

var _route_positions := PackedVector3Array()
var _route_distances := PackedFloat32Array()
var _route_lefts := PackedVector3Array()
var _route_uphill_signs := PackedFloat32Array()
var _height_samples := PackedFloat32Array()
var _grid_origin := Vector2.ZERO
var _grid_size := Vector2i.ZERO
var _grid_spacing := 100.0
var _bounds := AABB()
var _ridge_centers: Array[Dictionary] = []
var _noise := FastNoiseLite.new()
var _world_origin := Vector2.ZERO
var _world_axis := Vector2(0.0, -1.0)
var _world_cross := Vector2(1.0, 0.0)
var _world_start_y := 0.0
var _world_grade := 0.0
var _mesh_instance: MeshInstance3D
var _massif_instance: MeshInstance3D
var _village_ridge_instance: MeshInstance3D
var _build_attempts := 0

const STATIC_RIDGE_COLUMNS := 41
const STATIC_RIDGE_ROWS := 19
# Static ridges are authored well outside the road, but route bends can bring
# their lower faces back across a later camera. Keep a full transition band
# below the local road and discard faces that touch that band.
const STATIC_RIDGE_PROTECTION_RADIUS_M := 1250.0
const STATIC_RIDGE_FACE_PROTECTION_RADIUS_M := 820.0

func _ready() -> void:
	_try_build()

func _try_build() -> void:
	if landscape_ready:
		return
	if route == null:
		if not route_path.is_empty():
			route = get_node_or_null(route_path) as SaisiesRoute
		if route == null:
			# This fallback keeps the script convenient when it is added beside a
			# Route node in the editor without an exported NodePath assignment.
			route = get_parent().get_node_or_null("Route") as SaisiesRoute
	if route == null:
		push_warning("SaisiesLandscape needs a SaisiesRoute at route_path")
		return
	if not route.route_ready():
		_build_attempts += 1
		if _build_attempts < 8:
			call_deferred("_try_build")
		else:
			push_warning("SaisiesLandscape route was not ready after deferred retries")
		return
	_build_landscape()

func _build_landscape() -> void:
	_noise.seed = random_seed
	_noise.frequency = 1.0
	_cache_route_samples()
	if _route_positions.size() < 2:
		push_warning("SaisiesLandscape route has too few samples")
		return

	var min_x := INF
	var max_x := -INF
	var min_z := INF
	var max_z := -INF
	for p in _route_positions:
		min_x = minf(min_x, p.x)
		max_x = maxf(max_x, p.x)
		min_z = minf(min_z, p.z)
		max_z = maxf(max_z, p.z)
	var padding := maxf(world_extent_m, 2500.0)
	_grid_spacing = clampf(grid_spacing_m, 80.0, 120.0)
	var columns := int(ceil((max_x - min_x + padding * 2.0) / _grid_spacing)) + 1
	var rows := int(ceil((max_z - min_z + padding * 2.0) / _grid_spacing)) + 1
	# Keep the generated asset bounded even if a future route has a wider
	# footprint.  The normal Saisies route stays close to 15k vertices at 100 m.
	while columns * rows > maxi(max_vertices, 1000) and _grid_spacing < 220.0:
		_grid_spacing *= 1.10
		columns = int(ceil((max_x - min_x + padding * 2.0) / _grid_spacing)) + 1
		rows = int(ceil((max_z - min_z + padding * 2.0) / _grid_spacing)) + 1
	_grid_origin = Vector2(min_x - padding, min_z - padding)
	_grid_size = Vector2i(columns, rows)
	_build_static_ridge_centers()

	_height_samples.resize(columns * rows)
	var min_height := INF
	var max_height := -INF
	for z_index in range(rows):
		for x_index in range(columns):
			var x := _grid_origin.x + float(x_index) * _grid_spacing
			var z := _grid_origin.y + float(z_index) * _grid_spacing
			var info := _nearest_route(Vector2(x, z))
			var height := _height_from_info(info)
			_height_samples[z_index * columns + x_index] = height
			min_height = minf(min_height, height)
			max_height = maxf(max_height, height)
	_bounds = AABB(Vector3(_grid_origin.x, min_height - 4.0, _grid_origin.y), Vector3((columns - 1) * _grid_spacing, max_height - min_height + 8.0, (rows - 1) * _grid_spacing))
	_build_mesh()
	_build_village_ridge()
	_build_s05_massif()
	landscape_ready = true
	set_meta("saisies_landscape_vertex_count", columns * rows)
	set_meta("saisies_landscape_triangle_count", (columns - 1) * (rows - 1) * 2)
	set_meta("saisies_landscape_grid_spacing_m", _grid_spacing)
	set_meta("saisies_landscape_route_length_m", route.length_m)
	set_meta("saisies_landscape_bounds", _bounds)
	set_meta("saisies_landscape_ridge_centers", _ridge_centers.size())
	set_meta("saisies_landscape_massif_vertices", int(_massif_instance.get_meta("saisies_ridge_vertex_count", 0)) if _massif_instance else 0)
	set_meta("saisies_landscape_village_ridge_vertices", int(_village_ridge_instance.get_meta("saisies_ridge_vertex_count", 0)) if _village_ridge_instance else 0)

func _cache_route_samples() -> void:
	_route_positions.clear()
	_route_distances.clear()
	_route_lefts.clear()
	_route_uphill_signs.clear()
	var spacing := clampf(route_sample_spacing_m, 80.0, 150.0)
	var count := int(ceil(route.length_m / spacing)) + 1
	for i in range(count):
		var s := minf(float(i) * spacing, route.length_m)
		if i == count - 1:
			s = route.length_m
		var route_local := route.pos_at(s)
		var route_world := route.to_global(route_local)
		var local_point := to_local(route_world)
		var left_world := route.global_transform.basis * route.left_at(s)
		var left_local := global_transform.basis.inverse() * left_world
		left_local.y = 0.0
		left_local = left_local.normalized()
		var section := route.section_at(s)
		var uphill_sign := 1.0 if String(section.get("uphill_side", "right")) == "left" else -1.0
		_route_positions.append(local_point)
		_route_distances.append(s)
		_route_lefts.append(left_local)
		_route_uphill_signs.append(uphill_sign)
	if _route_positions.size() >= 2:
		var first := _route_positions[0]
		var last := _route_positions[_route_positions.size() - 1]
		_world_origin = Vector2(first.x, first.z)
		var end_xz := Vector2(last.x, last.z)
		_world_axis = (end_xz - _world_origin).normalized()
		if _world_axis.length_squared() < 0.0001:
			_world_axis = Vector2(0.0, -1.0)
		_world_cross = Vector2(-_world_axis.y, _world_axis.x)
		_world_start_y = first.y
		_world_grade = (last.y - first.y) / maxf(end_xz.distance_to(_world_origin), 1.0)

func _build_static_ridge_centers() -> void:
	# These centers are used only to vary the heightfield's surface colors. The
	# actual silhouettes are separate fixed meshes with route-clearance masks.
	_ridge_centers.clear()
	for spec in [
		{"s": route.acceptance_distance("S03") if route.has_method("acceptance_distance") else 1030.0, "ahead": 2250.0, "right": 2250.0, "radius": 1700.0},
		{"s": route.acceptance_distance("S05") if route.has_method("acceptance_distance") else 2880.0, "ahead": 2750.0, "right": 2700.0, "radius": 1800.0}
	]:
		var anchor_world := route.to_global(route.pos_at(float(spec["s"])))
		var forward := route.global_transform.basis * route.tangent_at(float(spec["s"]))
		var left := route.global_transform.basis * route.left_at(float(spec["s"]))
		var world_point := anchor_world + forward * float(spec["ahead"]) - left * float(spec["right"])
		var local_point := to_local(world_point)
		_ridge_centers.append({
			"position": Vector2(local_point.x, local_point.z),
			"radius": float(spec["radius"]),
			"lift": 1.0
		})

func _ridge_lift(point_xz: Vector2) -> float:
	var lift := 0.0
	for ridge in _ridge_centers:
		var radius := maxf(float(ridge["radius"]), 1.0)
		var distance_sq := point_xz.distance_squared_to(ridge["position"])
		lift += float(ridge["lift"]) * exp(-distance_sq / (2.0 * radius * radius))
	return lift

func _ridge_factor(point_xz: Vector2) -> float:
	var factor := 0.0
	for ridge in _ridge_centers:
		var radius := maxf(float(ridge["radius"]), 1.0)
		var distance_sq := point_xz.distance_squared_to(ridge["position"])
		factor = maxf(factor, exp(-distance_sq / (2.0 * radius * radius)))
	return clampf(factor, 0.0, 1.0)

func _nearest_route(point_xz: Vector2) -> Dictionary:
	var best_distance_sq := INF
	var best_index := 0
	var best_t := 0.0
	for i in range(_route_positions.size() - 1):
		var a := _route_positions[i]
		var b := _route_positions[i + 1]
		var a2 := Vector2(a.x, a.z)
		var ab := Vector2(b.x - a.x, b.z - a.z)
		var ab_length_sq := maxf(ab.length_squared(), 0.0001)
		var t := clampf((point_xz - a2).dot(ab) / ab_length_sq, 0.0, 1.0)
		var nearest := a2 + ab * t
		var distance_sq := point_xz.distance_squared_to(nearest)
		if distance_sq < best_distance_sq:
			best_distance_sq = distance_sq
			best_index = i
			best_t = t
	var start := _route_positions[best_index]
	var finish := _route_positions[best_index + 1]
	var nearest_point := start.lerp(finish, best_t)
	var nearest_left := _route_lefts[best_index].lerp(_route_lefts[best_index + 1], best_t).normalized()
	var signed_side := (Vector2(point_xz.x - nearest_point.x, point_xz.y - nearest_point.z)).dot(Vector2(nearest_left.x, nearest_left.z))
	return {
		"distance_m": sqrt(best_distance_sq),
		"side": signed_side,
		"route_y": nearest_point.y,
		"distance_along_m": lerpf(_route_distances[best_index], _route_distances[best_index + 1], best_t),
		"uphill_sign": lerpf(_route_uphill_signs[best_index], _route_uphill_signs[best_index + 1], best_t),
		"x": point_xz.x,
		"z": point_xz.y
	}

func _height_from_info(info: Dictionary) -> float:
	var distance := float(info["distance_m"])
	var signed_side := float(info["side"])
	var side_sign := 1.0 if signed_side >= 0.0 else -1.0
	var road_y := float(info["route_y"])
	var s := float(info["distance_along_m"])
	var uphill_sign := signf(float(info["uphill_sign"]))
	var protected_y := road_y - corridor_sink_m
	var edge_y := road_y
	if distance > protection_radius_m:
		# The route's own 110 m ribbon is the authority for the near bank.  A
		# sample just beyond it starts from the same side height, then rolls into
		# the larger valley terrain instead of leaving a hard shelf.
		var edge_u := side_sign * corridor_radius_m
		edge_y = route.ground_y(s, edge_u)
	var slope_factor := 0.18 if side_sign == uphill_sign else -0.055
	var near_target := edge_y + maxf(distance - corridor_radius_m, 0.0) * slope_factor
	var edge_blend := smoothstep(protection_radius_m - 8.0, protection_radius_m + 48.0, distance)
	var near_height := lerpf(protected_y, near_target, edge_blend)
	var far_blend := smoothstep(protection_radius_m + 80.0, transition_end_m, distance)
	var far_height := _far_height(info, distance, side_sign, uphill_sign)
	return lerpf(near_height, far_height, far_blend)

func _far_height(info: Dictionary, distance: float, side_sign: float, uphill_sign: float) -> float:
	var x := float(info["x"])
	var z := float(info["z"])
	var broad := _noise.get_noise_2d(x * 0.00024 + 37.0, z * 0.00024 - 19.0)
	var mid := _noise.get_noise_2d(x * 0.00072 - 73.0, z * 0.00072 + 41.0)
	var fine := _noise.get_noise_2d(x * 0.0022 + 11.0, z * 0.0022 + 89.0)
	var direction_wave := 0.08 * sin(x * 0.00063 + z * 0.00019 + 1.7) + 0.05 * sin(z * 0.00031 - x * 0.00028)
	var world_roll := broad * 105.0 + mid * 34.0 + fine * 9.0 + direction_wave * 42.0
	var far_factor := smoothstep(700.0, 2800.0, distance)
	var uphill_bias := 18.0 if side_sign == uphill_sign else -18.0
	# The far field is derived from one continuous world-space grade. It must
	# not restart from `route_y` at each nearest segment, otherwise a later bend
	# can create a vertical rectangular face in front of an earlier camera.
	return _world_height_base(Vector2(x, z)) - 80.0 + uphill_bias * far_factor + world_roll * lerpf(0.55, 1.0, far_factor)

func _world_height_base(point_xz: Vector2) -> float:
	var relative := point_xz - _world_origin
	var along := relative.dot(_world_axis)
	var across := relative.dot(_world_cross)
	# A shallow cross-valley bowl keeps the fixed terrain readable while the
	# authored ridge meshes provide the larger mountain silhouettes.
	var bowl := -0.0000065 * across * across
	return _world_start_y + along * _world_grade + bowl

func _build_mesh() -> void:
	var columns := _grid_size.x
	var rows := _grid_size.y
	var vertices := PackedVector3Array()
	var normals := PackedVector3Array()
	var colors := PackedColorArray()
	var uvs := PackedVector2Array()
	vertices.resize(columns * rows)
	normals.resize(columns * rows)
	colors.resize(columns * rows)
	uvs.resize(columns * rows)
	for z_index in range(rows):
		for x_index in range(columns):
			var index := z_index * columns + x_index
			var x := _grid_origin.x + float(x_index) * _grid_spacing
			var z := _grid_origin.y + float(z_index) * _grid_spacing
			var height := _height_samples[index]
			vertices[index] = Vector3(x, height, z)
			var left_height := _height_at_grid(x_index - 1, z_index)
			var right_height := _height_at_grid(x_index + 1, z_index)
			var up_height := _height_at_grid(x_index, z_index - 1)
			var down_height := _height_at_grid(x_index, z_index + 1)
			normals[index] = Vector3(left_height - right_height, _grid_spacing * 2.0, up_height - down_height).normalized()
			var info := _nearest_route(Vector2(x, z))
			var distance := float(info["distance_m"])
			var slope := clampf((absf(left_height - right_height) + absf(up_height - down_height)) / (_grid_spacing * 2.0), 0.0, 1.0)
			var distant := smoothstep(700.0, 3000.0, distance)
			var green := Color(0.035, 0.12, 0.045).lerp(Color(0.07, 0.18, 0.09), distant)
			# The ridge uses broad, fixed forest/meadow patches so its face reads
			# as an alpine valley wall at S05 instead of a single smooth strip.
			var ridge_factor := _ridge_factor(Vector2(x, z))
			var patch_noise := 0.5 + 0.5 * _noise.get_noise_2d(x * 0.00165 + 127.0, z * 0.00165 - 53.0)
			var forest_patch := smoothstep(0.42, 0.76, patch_noise) * ridge_factor
			var meadow_patch := smoothstep(0.48, 0.82, 1.0 - patch_noise) * ridge_factor
			green = green.lerp(Color(0.025, 0.09, 0.035), forest_patch * 0.72)
			green = green.lerp(Color(0.12, 0.22, 0.07), meadow_patch * 0.35)
			var rock := Color(0.12, 0.16, 0.11)
			var rock_mix := (0.055 * slope + 0.012 * distant) * (1.0 - 0.72 * ridge_factor)
			colors[index] = green.lerp(rock, rock_mix)
			uvs[index] = Vector2(x, z) * 0.018
	var indices := PackedInt32Array()
	indices.resize((columns - 1) * (rows - 1) * 6)
	var cursor := 0
	for z_index in range(rows - 1):
		for x_index in range(columns - 1):
			var a := z_index * columns + x_index
			var b := a + 1
			var c := a + columns
			var d := c + 1
			# Reverse the grid winding so the generated terrain faces upward.
			indices[cursor] = a
			indices[cursor + 1] = c
			indices[cursor + 2] = b
			indices[cursor + 3] = b
			indices[cursor + 4] = c
			indices[cursor + 5] = d
			cursor += 6
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = vertices
	arrays[Mesh.ARRAY_NORMAL] = normals
	arrays[Mesh.ARRAY_COLOR] = colors
	arrays[Mesh.ARRAY_TEX_UV] = uvs
	arrays[Mesh.ARRAY_INDEX] = indices
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	_mesh_instance = MeshInstance3D.new()
	_mesh_instance.name = "SaisiesStaticLandscape"
	_mesh_instance.mesh = mesh
	_mesh_instance.material_override = _landscape_material()
	_mesh_instance.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_mesh_instance.extra_cull_margin = 10000.0
	add_child(_mesh_instance)

func _build_village_ridge() -> void:
	# The first three acceptance views look past the resort toward a fixed
	# forested ridge.  Its lateral offset keeps it outside the route envelope;
	# it is authored once in world space and never follows the camera.
	var s03 := route.acceptance_distance("S03") if route.has_method("acceptance_distance") else 1030.0
	_village_ridge_instance = _build_static_ridge_mesh(
		"SaisiesStaticVillageRidge", s03, 1400.0, 1650.0, 900.0, 3600.0, 650.0, 17)

func _build_s05_massif() -> void:
	# The v2 route makes the 190--330 s left cut visible, leaving this fixed,
	# opposite valley massif in the S05 view. Keep the front shoulder in the
	# 2.5--3.5 km band used by the source projection, then taper it before the
	# later route returns toward the ridge. The clearance mask is still checked
	# against every route sample, so this cannot become an S08/S09 roof.
	var s05 := route.acceptance_distance("S05") if route.has_method("acceptance_distance") else 2880.0
	_massif_instance = _build_static_ridge_mesh(
		"SaisiesStaticS05Massif", s05, 1200.0, 1850.0, 2350.0, 5050.0, 780.0, 53)

func _build_static_ridge_mesh(node_name: String, anchor_s: float, lateral_center: float, lateral_half_width: float, depth_start: float, depth_end: float, peak_height: float, seed_offset: int) -> MeshInstance3D:
	var anchor_world := route.to_global(route.pos_at(anchor_s))
	var anchor := to_local(anchor_world)
	var forward_world := route.global_transform.basis * route.tangent_at(anchor_s)
	var left_world := route.global_transform.basis * route.left_at(anchor_s)
	var forward := global_transform.basis.inverse() * forward_world
	var left := global_transform.basis.inverse() * left_world
	forward.y = 0.0
	left.y = 0.0
	forward = forward.normalized()
	left = left.normalized()
	var columns := STATIC_RIDGE_COLUMNS
	var rows := STATIC_RIDGE_ROWS
	var vertices := PackedVector3Array()
	var colors := PackedColorArray()
	var uvs := PackedVector2Array()
	var route_distances := PackedFloat32Array()
	var tail_tapers := PackedFloat32Array()
	vertices.resize(columns * rows)
	colors.resize(columns * rows)
	uvs.resize(columns * rows)
	route_distances.resize(columns * rows)
	tail_tapers.resize(columns * rows)
	for z_index in range(rows):
		var depth_t := float(z_index) / float(rows - 1)
		var depth := lerpf(depth_start, depth_end, depth_t)
		var rise_in := smoothstep(0.0, 0.52, depth_t)
		var fall_out := 1.0 - smoothstep(0.74, 1.0, depth_t)
		for x_index in range(columns):
			var across_t := float(x_index) / float(columns - 1)
			var lateral := lerpf(lateral_center - lateral_half_width, lateral_center + lateral_half_width, across_t)
			var world := anchor + forward * depth - left * lateral
			var point_xz := Vector2(world.x, world.z)
			var route_info := _nearest_route(point_xz)
			var route_distance := float(route_info["distance_m"])
			var route_s := float(route_info["distance_along_m"])
			route_distances[z_index * columns + x_index] = route_distance
			var route_clear := smoothstep(STATIC_RIDGE_FACE_PROTECTION_RADIUS_M, STATIC_RIDGE_PROTECTION_RADIUS_M, route_distance)
			var tail_taper := 1.0
			if node_name == "SaisiesStaticVillageRidge":
				# This ridge is authored for the resort views around S03.  The
				# continuous route later passes behind its old tail; taper that fixed
				# tail before S05 so it cannot become a near-camera diagonal plane.
				var after_anchor := route_s - anchor_s
				tail_taper = 1.0 - smoothstep(900.0, 1550.0, after_anchor)
				route_clear *= tail_taper
			tail_tapers[z_index * columns + x_index] = tail_taper
			var shoulder := exp(-pow((lateral - lateral_center) / maxf(lateral_half_width * 0.76, 1.0), 2.0))
			var contour_broad := _noise.get_noise_2d(point_xz.x * 0.0012 + seed_offset, point_xz.y * 0.0012 - seed_offset)
			var contour_fine := _noise.get_noise_2d(point_xz.x * 0.0045 - seed_offset * 1.7, point_xz.y * 0.0045 + seed_offset * 0.9)
			var contour := 0.89 + 0.075 * contour_broad + 0.035 * contour_fine
			var rise := peak_height * rise_in * fall_out * shoulder * contour * route_clear
			var base := _world_height_base(point_xz) - 42.0
			var vertex_height := base + rise
			if route_distance < STATIC_RIDGE_PROTECTION_RADIUS_M:
				# `_world_height_base()` is continuous in world space, but a bent
				# route can put that base above the local road. Clamp the final
				# vertex, including its authored rise, below the road ribbon.
				var road_y := route.ground_y(route_s, 0.0)
				vertex_height = minf(vertex_height, road_y - maxf(corridor_sink_m, 8.0))
			vertices[z_index * columns + x_index] = Vector3(world.x, vertex_height, world.z)
			var patch_macro := 0.5 + 0.5 * _noise.get_noise_2d(point_xz.x * 0.0018 + seed_offset * 2.0, point_xz.y * 0.0018 - seed_offset * 3.0)
			var patch_detail := 0.5 + 0.5 * _noise.get_noise_2d(point_xz.x * 0.0065 - seed_offset, point_xz.y * 0.0065 + seed_offset * 2.0)
			var patch_noise := patch_macro * 0.72 + patch_detail * 0.28
			var forest := smoothstep(0.40, 0.72, patch_noise)
			var meadow := smoothstep(0.46, 0.84, 1.0 - patch_noise)
			var shade := Color(0.022, 0.085, 0.028)
			var forest_green := Color(0.060, 0.235, 0.055)
			var meadow_green := Color(0.245, 0.420, 0.105)
			var color := shade.lerp(forest_green, forest * 0.86)
			color = color.lerp(meadow_green, meadow * 0.62)
			colors[z_index * columns + x_index] = color
			uvs[z_index * columns + x_index] = point_xz * 0.012
	var indices := PackedInt32Array()
	for z_index in range(rows - 1):
		for x_index in range(columns - 1):
			var a := z_index * columns + x_index
			var b := a + 1
			var c := a + columns
			var d := c + 1
			# Do not leave a base face spanning the protected corridor. A rise
			# mask alone still leaves a large, grey roof when the route bends.
			var protected_face := route_distances[a] < STATIC_RIDGE_FACE_PROTECTION_RADIUS_M
			protected_face = protected_face or route_distances[b] < STATIC_RIDGE_FACE_PROTECTION_RADIUS_M
			protected_face = protected_face or route_distances[c] < STATIC_RIDGE_FACE_PROTECTION_RADIUS_M
			protected_face = protected_face or route_distances[d] < STATIC_RIDGE_FACE_PROTECTION_RADIUS_M
			if node_name == "SaisiesStaticVillageRidge":
				protected_face = protected_face or tail_tapers[a] <= 0.001
				protected_face = protected_face or tail_tapers[b] <= 0.001
				protected_face = protected_face or tail_tapers[c] <= 0.001
				protected_face = protected_face or tail_tapers[d] <= 0.001
			if protected_face:
				continue
			# Match the upward normals above: across (b-a) then depth (c-a).
			indices.append(a)
			indices.append(b)
			indices.append(c)
			indices.append(b)
			indices.append(d)
			indices.append(c)
	# Remove vertices that are no longer referenced by a face. This keeps the
	# diagnostic AABB/projection tied to rendered geometry, rather than buried
	# vertices that only existed in the original rectangular grid.
	var used := {}
	for raw_index in indices:
		used[int(raw_index)] = true
	var remap := PackedInt32Array()
	remap.resize(vertices.size())
	for index in range(remap.size()):
		remap[index] = -1
	var compact_vertices := PackedVector3Array()
	var compact_colors := PackedColorArray()
	var compact_uvs := PackedVector2Array()
	for old_index in range(vertices.size()):
		if not used.has(old_index):
			continue
		remap[old_index] = compact_vertices.size()
		compact_vertices.append(vertices[old_index])
		compact_colors.append(colors[old_index])
		compact_uvs.append(uvs[old_index])
	vertices = compact_vertices
	colors = compact_colors
	uvs = compact_uvs
	var compact_indices := PackedInt32Array()
	for raw_index in indices:
		compact_indices.append(remap[int(raw_index)])
	indices = compact_indices
	var normals := PackedVector3Array()
	normals.resize(vertices.size())
	for face_start in range(0, indices.size(), 3):
		var a := vertices[indices[face_start]]
		var b := vertices[indices[face_start + 1]]
		var c := vertices[indices[face_start + 2]]
		var face_normal := (b - a).cross(c - a).normalized()
		normals[indices[face_start]] += face_normal
		normals[indices[face_start + 1]] += face_normal
		normals[indices[face_start + 2]] += face_normal
	for index in range(normals.size()):
		# `across` then `depth` gives +Y; retain a stable upward normal even
		# on a degenerate boundary vertex after face culling.
		normals[index] = normals[index].normalized()
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = vertices
	arrays[Mesh.ARRAY_NORMAL] = normals
	arrays[Mesh.ARRAY_COLOR] = colors
	arrays[Mesh.ARRAY_TEX_UV] = uvs
	arrays[Mesh.ARRAY_INDEX] = indices
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	var instance := MeshInstance3D.new()
	instance.name = node_name
	instance.mesh = mesh
	instance.set_meta("saisies_ridge_vertex_count", vertices.size())
	instance.set_meta("saisies_ridge_triangle_count", indices.size() / 3)
	instance.material_override = _mountain_material()
	instance.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	instance.extra_cull_margin = 10000.0
	add_child(instance)
	return instance

func _mountain_material() -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	# Vertex colors define broad forest/meadow zones; the existing aerial texture
	# adds small grass/rock breakup that a low-poly distant ridge would otherwise
	# lose. World triplanar UVs keep that breakup fixed in the scene.
	material.albedo_texture = load("res://assets/textures/aerial_grass_rock_diff.jpg")
	material.normal_enabled = true
	material.normal_texture = load("res://assets/textures/aerial_grass_rock_nor.jpg")
	material.roughness_texture = load("res://assets/textures/aerial_grass_rock_rough.jpg")
	material.albedo_color = Color(0.80, 1.02, 0.66)
	material.vertex_color_use_as_albedo = true
	material.shading_mode = BaseMaterial3D.SHADING_MODE_PER_PIXEL
	material.roughness = 0.96
	material.cull_mode = BaseMaterial3D.CULL_DISABLED
	material.uv1_triplanar = true
	material.uv1_world_triplanar = true
	material.uv1_scale = Vector3.ONE * 0.038
	return material

func _height_at_grid(x_index: int, z_index: int) -> float:
	var x := clampi(x_index, 0, _grid_size.x - 1)
	var z := clampi(z_index, 0, _grid_size.y - 1)
	return _height_samples[z * _grid_size.x + x]

func _landscape_material() -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	# Use the existing aerial grass/rock macro texture with normal detail.  The
	# earlier unshaded vertex-only material turned every distant face into a
	# mint plane and discarded all forest/meadow surface variation.
	material.albedo_texture = load("res://assets/textures/aerial_grass_rock_diff.jpg")
	material.normal_enabled = true
	material.normal_texture = load("res://assets/textures/aerial_grass_rock_nor.jpg")
	material.roughness_texture = load("res://assets/textures/aerial_grass_rock_rough.jpg")
	material.albedo_color = Color(1.08, 1.12, 0.86)
	material.vertex_color_use_as_albedo = true
	material.shading_mode = BaseMaterial3D.SHADING_MODE_PER_PIXEL
	material.roughness = 0.96
	material.cull_mode = BaseMaterial3D.CULL_DISABLED
	material.uv1_triplanar = true
	material.uv1_world_triplanar = true
	material.uv1_scale = Vector3.ONE * 0.038
	return material

## Returns the static terrain height below a world-space XZ position.
## Vector3 input is accepted as a convenience; its y component is ignored.
func sample_landscape_height(world_xz: Variant) -> float:
	if not landscape_ready:
		return NAN
	var xz := Vector2.ZERO
	if world_xz is Vector2:
		xz = world_xz
	elif world_xz is Vector3:
		xz = Vector2(world_xz.x, world_xz.z)
	else:
		return NAN
	var local := to_local(Vector3(xz.x, 0.0, xz.y))
	var info := _nearest_route(Vector2(local.x, local.z))
	var local_height := _height_from_info(info)
	return to_global(Vector3(local.x, local_height, local.z)).y

func landscape_bounds() -> AABB:
	return _bounds
