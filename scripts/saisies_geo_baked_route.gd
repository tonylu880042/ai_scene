class_name SaisiesGeoBakedRoute
extends "res://scripts/saisies_geo_route.gd"

## Route facade used by the manually frozen geographic scene.
##
## The road, shoulder, terrain and collision children are already authored in
## the packed scene.  On reload this subclass only restores the lightweight
## geographic route samples/curve and binds those existing children; it never
## calls the procedural road or terrain builders.

@export_file("*.json") var baked_manifest_file := ""

func _ready() -> void:
	_load_route_data()
	_build_samples()
	_build_curve()
	_bind_baked_children()
	_ready_built = _road_collision != null and _samples.size() >= 2 and curve != null
	set_meta("saisies_geo_baked_route_ready", _ready_built)
	set_meta("saisies_geo_baked_route_build_mode", "samples+curve_only")
	set_meta("saisies_geo_baked_route_bound_existing_children", _ready_built)

func _bind_baked_children() -> void:
	# These nodes were generated by SaisiesRoute before the bake.  Keep the
	# references used by route_ready() and the inherited road/ground query API,
	# without creating a second mesh or collision body on reload.
	_road_mesh = find_child("SaisiesAsphalt", true, false) as MeshInstance3D
	# GeoRoute deliberately leaves the broad grass terrain to the external
	# GeoLandscape/SaisiesGeoTerrain node.  Its route-local mesh is only the
	# narrow geographic gravel seam.
	_terrain_mesh = null
	_shoulder_mesh = find_child("SaisiesGeoGravelShoulders", true, false) as MeshInstance3D
	_road_collision = find_child("SaisiesRoadCollision", true, false) as StaticBody3D
