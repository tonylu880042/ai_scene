<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the engine-free AIScene.Core sources and their NUnit tests outside Unity:
       dotnet test unity/CoreTests   (package under test: AISCENE_PACKAGE, default export/packages/weissensee_rolling_hills) -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../AIScenePlayer/Assets/AIScene/Runtime/Core/**/*.cs" />
    <Compile Include="../AIScenePlayer/Assets/AIScene/Tests/Core/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
  </ItemGroup>
</Project>
